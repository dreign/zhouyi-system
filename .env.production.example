# Database - Vercel Postgres (自动配置)
# DATABASE_URL=postgresql://xxx:xxx@xxx.vercel-postgres.com:5432/xxx

# AI API - DeepSeek API Key (必须)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Authentication - NextAuth
NEXTAUTH_SECRET=generate-a-random-secret-key
NEXTAUTH_URL=https://your-app.vercel.app

# WeChat Login Configuration (微信登录)
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_REDIRECT_URI=https://your-app.vercel.app/api/auth/wechat/callback

# Alipay Login Configuration (支付宝登录)
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_APP_PRIVATE_KEY=your-alipay-private-key
ALIPAY_ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_REDIRECT_URI=https://your-app.vercel.app/api/auth/alipay/callback
