generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String?
  avatar    String?
  language  String   @default("zh-CN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wechatOpenId  String?  @unique @map("wechat_open_id")
  alipayId      String?  @unique @map("alipay_id")
  
  divinationRecords DivinationRecord[]
  tokenBalance     TokenBalance?
  tokenUsage       TokenUsage[]

  @@map("users")
}

model TokenBalance {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  balance       Int      @default(0)
  totalPurchased Int     @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id])

  @@map("token_balance")
}

model TokenUsage {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  type       String
  tokens     Int
  cost       Int
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])

  @@map("token_usage")
}

model DivinationRecord {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  type       String
  inputData  String   @map("input_data")
  result     String
  detailResult String? @map("detail_result")
  isPaid     Boolean  @default(false)
  cost       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])

  @@map("divination_records")
}

model GuaData {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  name           String
  fullName       String  @map("full_name")
  summary        String?
  guaci          String?
  yaoci          String?
  interpretation String?
  
  @@map("gua_data")
}

model CharacterData {
  id           Int     @id @default(autoincrement())
  char         String  @unique
  stroke       Int
  pinyin       String?
  wuxing       String?
  kangxiStroke Int?   @map("kangxi_stroke")

  @@map("character_data")
}
